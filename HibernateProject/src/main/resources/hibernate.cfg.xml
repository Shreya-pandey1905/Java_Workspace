<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>



        <property name="connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="connection.url">jdbc:mysql://localhost:3307/hibernate</property>
        <property name="connection.username">root</property>
        <property name="connection.password"></property>
        <property name="hbm2ddl.auto">update</property>
        <property name="show_sql">true</property>
        <mapping class="org.entities.User"/>
<!--        <mapping class="entities.Address"/>-->
<!--        <mapping class="entities.Student"/>-->
        <mapping class="org.entities.Questions"/>
        <mapping class="org.entities.Answers"/>
<!--        <mapping class="entities.QnsOneToMany"/>-->
<!--        <mapping class="entities.AnsManyToOne"/>-->



    </session-factory>
</hibernate-configuration>